{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxaudit.local/schemas/import-preview-v1.json",
  "title": "oxAudit bounded report import preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "mediaType",
    "fileName",
    "contentSha256",
    "componentRecords",
    "findingRecords",
    "reviewRecords",
    "conflictCount",
    "conflicts",
    "unmappedCount",
    "unmappedRecords",
    "warnings",
    "canImportInventory"
  ],
  "properties": {
    "format": { "enum": ["oxaudit-json", "sarif", "cyclonedx", "spdx", "openvex", "cyclonedx-vex"] },
    "mediaType": { "type": "string", "minLength": 1 },
    "fileName": { "type": "string", "minLength": 1 },
    "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "componentRecords": { "type": "integer", "minimum": 0 },
    "findingRecords": { "type": "integer", "minimum": 0 },
    "reviewRecords": { "type": "integer", "minimum": 0 },
    "conflictCount": { "type": "integer", "minimum": 0 },
    "conflicts": { "type": "array", "maxItems": 200, "items": { "type": "string" } },
    "unmappedCount": { "type": "integer", "minimum": 0 },
    "unmappedRecords": { "type": "array", "maxItems": 200, "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "canImportInventory": { "type": "boolean" }
  }
}
