{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxaudit.dev/schemas/compliance-profile.schema.json",
  "title": "oxAudit compliance readiness profile",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "domain", "jurisdiction", "sourceLabel", "sourceUrl", "copyrightNotice", "disclaimer", "controls"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$" },
    "name": { "type": "string", "minLength": 3, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "domain": { "type": "string", "minLength": 3, "maxLength": 120 },
    "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 160 },
    "sourceLabel": { "type": "string", "minLength": 3, "maxLength": 160 },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "copyrightNotice": { "type": "string", "minLength": 20, "maxLength": 500 },
    "disclaimer": { "type": "string", "minLength": 40, "maxLength": 800 },
    "controls": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "reference", "title", "objective", "assurance", "check"],
        "properties": {
          "id": { "type": "string", "minLength": 2, "maxLength": 80 },
          "reference": { "type": "string", "minLength": 2, "maxLength": 160 },
          "title": { "type": "string", "minLength": 3, "maxLength": 160 },
          "objective": { "type": "string", "minLength": 10, "maxLength": 800 },
          "assurance": { "enum": ["automatedEvidence", "humanAttestation", "mixed"] },
          "check": {
            "type": "object",
            "properties": {
              "fileGroups": { "type": "array", "maxItems": 12, "items": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "maxLength": 160 } } },
              "runKinds": { "type": "array", "uniqueItems": true, "items": { "enum": ["source", "secrets", "dependencies", "binary", "firmware", "import", "verification"] } },
              "manual": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
