// oxAudit in a Jenkins declarative pipeline. Copy the stage into your
// Jenkinsfile, and examples/ci/install-oxaudit.sh into ci/install-oxaudit.sh.
//
// Findings show as test results through the JUnit plugin: a finding at or
// above the gate is a failed test, everything else is a skipped one. The
// stage fails on a `deny` violation of .oxaudit/component-policy.json or on
// source findings at or above --fail-on; reports are archived either way.
// The Linux CLI needs glibc 2.34 or newer from v0.3.2 on (Debian 12, Ubuntu
// 22.04, RHEL 9 and later): run the stage on an agent that has it.
pipeline {
  agent any
  environment {
    // Pin both together. See install-oxaudit.sh for where the digest comes from.
    OXAUDIT_VERSION = 'v0.3.3'
    OXAUDIT_SHA256  = '9661d333eb8238b86b99e2c3993627c4d2b7405a228c391c6288e3dd0a827829'
  }
  stages {
    stage('oxAudit') {
      steps {
        sh 'sh ci/install-oxaudit.sh'
        sh '''
          set -u
          mkdir -p oxaudit-reports
          status=0
          .oxaudit-tool/oxaudit-cli scan . --fail-on high \
            --format junit -o oxaudit-reports/source-junit.xml || status=$?
          .oxaudit-tool/oxaudit-cli sca . --db oxaudit-reports/db/findings.db \
            --format junit -o oxaudit-reports/sca-junit.xml \
            --notices oxaudit-reports/THIRD-PARTY-NOTICES.md || status=$?
          .oxaudit-tool/oxaudit-cli sca . --db oxaudit-reports/db/findings.db --offline --report-only \
            --format json -o oxaudit-reports/sca.json || status=$?
          .oxaudit-tool/oxaudit-cli deps . --db oxaudit-reports/db/findings.db --offline \
            --format cyclonedx -o oxaudit-reports/sbom.cdx.json || status=$?
          exit $status
        '''
      }
      post {
        always {
          junit testResults: 'oxaudit-reports/*-junit.xml', allowEmptyResults: false
          archiveArtifacts artifacts: 'oxaudit-reports/*.json, oxaudit-reports/*.xml, oxaudit-reports/*.md',
                           allowEmptyArchive: true
        }
      }
    }
  }
}
